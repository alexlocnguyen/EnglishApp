# Create a key in Google AI Studio and keep it on the server.
GEMINI_API_KEY=

# Models available on Gemini API; account quotas and access can vary.
GEMINI_MODEL=gemini-3.5-flash-lite

# Kokoro English TTS (no API key required)
KOKORO_LANG_CODE=a
KOKORO_VOICE=af_heart
KOKORO_SPEED=1.0

# Comma-separated origins. Use * only for local development.
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
MAX_AUDIO_MB=14

# Firebase email/password Authentication is called by the backend BFF.
# This Web API key is public Firebase configuration; restrict it to the Firebase APIs you use.
FIREBASE_API_KEY=

# Required: generate with `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`.
# Keep this server-side key private and stable; rotating it invalidates existing sessions.
AUTH_SESSION_ENCRYPTION_KEY=
# Optional persistent SQLite path. Use a durable volume in production.
AUTH_SESSION_DB_PATH=
APP_ENV=development
# For a frontend on a different site in production, set SameSite=None (requires HTTPS).
BFF_COOKIE_SAMESITE=lax
