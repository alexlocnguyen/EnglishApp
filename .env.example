# API gốc của backend, ví dụ http://192.168.1.10:8000 khi chạy trên thiết bị cùng mạng
EXPO_PUBLIC_API_URL=http://localhost:8000

# Endpoint POST nhận { "topic": string, "transcript": string }
EXPO_PUBLIC_AI_FEEDBACK_PATH=/api/ai/speaking-feedback

# Backend Gemini nhận tệp ghi âm và trả về đánh giá phát âm/độ rõ tương đối
EXPO_PUBLIC_AI_ANALYZE_PATH=/api/analyze

# Backend tạo audio giọng tiếng Anh từ Gemini TTS
EXPO_PUBLIC_AI_SPEECH_PATH=/api/speech

# Endpoint dịch câu tiếng Anh AI vừa nói sang tiếng Việt
EXPO_PUBLIC_AI_TRANSLATE_PATH=/api/translate

# Auth is served by the backend. Configure FIREBASE_API_KEY and AUTH_SESSION_ENCRYPTION_KEY
# in backend/.env. Do not expose Firebase session tokens or backend secrets as EXPO_PUBLIC_ values.
