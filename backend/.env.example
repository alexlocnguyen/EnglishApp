# Create a key in Google AI Studio and keep it on the server.
GEMINI_API_KEY=

# Models available on Gemini API; account quotas and access can vary.
GEMINI_MODEL=gemini-3.5-flash-lite

# Kokoro English TTS (no API key required)
KOKORO_LANG_CODE=a
KOKORO_VOICE=af_heart
KOKORO_SPEED=1.0

# Comma-separated origins. Use * only for local development.
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
MAX_AUDIO_MB=14
